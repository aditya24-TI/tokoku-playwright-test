{
  "name": "tokoku-playwright-test",
  "version": "1.0.0",
  "description": "Eksplorasi Cross-Browser Web Automation Testing menggunakan Playwright pada Web Dummy TokoKu",
  "scripts": {
    "serve": "npx serve . -l 3000",
